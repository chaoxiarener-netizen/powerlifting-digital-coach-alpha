{
  "version": "v1",
  "rule_set_name": "力量举宏量算法数据库",
  "source_document": {
    "primary_docx": "力量举营养宏量算法数据库_修复版.docx",
    "workspace_copy": "macro_algorithm_database_source.docx",
    "scope_note": "V1 仅激活增肌、力量、减脂三类目标；冲击减量、赛前减重、女性周期和水切仅保留字段，不自动进入模块二主流程。"
  },
  "energy_availability": {
    "formula": "EA = (EI - EEE) / FFM",
    "base_metric": "LBM",
    "units": "kcal/kg LBM/day",
    "thresholds": {
      "clinical_danger": {
        "male_lt": 25,
        "female_lt": 30,
        "note": "低于该阈值时存在明显的相对能量缺乏风险，应提示优先提高能量可用性。"
      },
      "subclinical_caution": {
        "male_range": [
          25,
          30
        ],
        "female_range": [
          30,
          45
        ],
        "note": "该区间可作为减脂期警戒带，不用于直接诊断。"
      },
      "optimal_adaptation": {
        "male_range": [
          40,
          45
        ],
        "female_gte": 45,
        "note": "增肌、力量和冲击减量等非减脂阶段，优先以该区间作为操作基线。"
      }
    },
    "operational_defaults": {
      "bulk_target_ea_floor": 45,
      "strength_target_ea_floor": 45,
      "cut_target_ea_floor_male": 25,
      "cut_target_ea_floor_female": 30
    }
  },
  "goal_profiles": {
    "bulk": {
      "label": "增肌期",
      "cycle_name": "增肌期 (Hypertrophy/Mass)",
      "energy_management": {
        "target_surplus_deficit_kcal_per_lbm": 4.5,
        "red_s_ea_threshold": 45,
        "recommended_daily_surplus_kcal": [
          200,
          300
        ]
      },
      "macronutrient_distribution": {
        "protein_range_g_per_kg_lbm": [
          1.9,
          2.6
        ],
        "fat_range_g_per_kg_tbw": [
          1.0,
          1.5
        ],
        "carb_range_g_per_kg_tbw": [
          4.0,
          7.0
        ],
        "notes": "仅采用微小盈余，优先保证功能性肥大；高容量训练日碳水需要逼近上限。"
      },
      "day_type_overrides": {
        "rest": {
          "carb_range_g_per_kg_tbw": [
            3.0,
            4.0
          ],
          "fat_ceiling_g_per_kg_tbw": 1.5
        },
        "heavy": {
          "carb_multiplier": 1.2
        }
      },
      "gender_specific_tweaks": {
        "female_luteal_phase_adjustment": "黄体期将蛋白质推向区间上沿，并将外源性碳水补偿系数上调约 1.2 倍。",
        "male_testosterone_support_fat_floor": 1.0
      }
    },
    "strength": {
      "label": "力量期",
      "cycle_name": "增力期 (Strength/Power)",
      "energy_management": {
        "target_surplus_deficit_kcal_per_lbm": 0.0,
        "red_s_ea_threshold": 45,
        "recommended_daily_surplus_kcal": [
          -100,
          100
        ]
      },
      "macronutrient_distribution": {
        "protein_range_g_per_kg_lbm": [
          2.0,
          2.5
        ],
        "fat_range_g_per_kg_tbw": [
          1.0,
          1.3
        ],
        "carb_range_g_per_kg_tbw": [
          3.0,
          5.0
        ],
        "notes": "总热量维持接近等热量，重点放在练前、练中、练后碳水时序，以对抗中枢疲劳。"
      },
      "day_type_overrides": {
        "rest": {
          "carb_range_g_per_kg_tbw": [
            2.0,
            3.0
          ],
          "fat_energy_share_percent": 30
        },
        "heavy": {
          "carb_multiplier": 1.5
        }
      },
      "gender_specific_tweaks": {
        "female_luteal_phase_adjustment": "黄体期高强度日练中应强制预留 30-40g 快速碳水。",
        "male_testosterone_support_fat_floor": 1.0
      }
    },
    "cut": {
      "label": "减脂期",
      "cycle_name": "减脂期 (Fat Loss/Cut)",
      "energy_management": {
        "target_surplus_deficit_kcal_per_lbm": -8.0,
        "red_s_ea_threshold": 30,
        "recommended_daily_deficit_kcal": [
          -500,
          -200
        ],
        "male_ea_floor": 25,
        "female_ea_floor": 30
      },
      "macronutrient_distribution": {
        "protein_range_g_per_kg_lbm": [
          2.5,
          4.2
        ],
        "fat_range_g_per_kg_tbw": [
          0.8,
          1.0
        ],
        "carb_range_g_per_kg_tbw": [
          2.0,
          4.0
        ],
        "notes": "优先通过高蛋白守住瘦体重，碳水绝不归零，并尽量把训练日前后窗口保住。"
      },
      "day_type_overrides": {
        "rest": {
          "carb_range_g_per_kg_tbw": [
            1.5,
            2.0
          ]
        },
        "heavy": {
          "carb_multiplier": 1.2
        }
      },
      "gender_specific_tweaks": {
        "female_luteal_phase_adjustment": "黄体期可允许轻微扩大热量缺口，但 EA 不得跌破 30 kcal/kg FFM。",
        "male_testosterone_support_fat_floor": 0.8
      }
    }
  },
  "day_type_multipliers": {
    "rest": {
      "label": "休息日",
      "energy_multiplier": 0.92,
      "carb_multiplier": 0.70,
      "protein_multiplier": 1.00,
      "fat_multiplier": 1.05,
      "carb_timing_enabled": false
    },
    "light": {
      "label": "轻训日",
      "energy_multiplier": 0.97,
      "carb_multiplier": 0.85,
      "protein_multiplier": 1.00,
      "fat_multiplier": 1.00,
      "carb_timing_enabled": true
    },
    "medium": {
      "label": "常规日",
      "energy_multiplier": 1.00,
      "carb_multiplier": 1.00,
      "protein_multiplier": 1.00,
      "fat_multiplier": 1.00,
      "carb_timing_enabled": true
    },
    "heavy": {
      "label": "重训日",
      "energy_multiplier": 1.05,
      "carb_multiplier": 1.15,
      "protein_multiplier": 1.00,
      "fat_multiplier": 0.98,
      "carb_timing_enabled": true
    }
  },
  "macro_formulas": {
    "energy": {
      "base_metric": "LBM",
      "use_profile_surplus_deficit_kcal_per_lbm": true,
      "fallback_when_bodyfat_missing": {
        "lbm_estimation_method": "TBW * (1 - default_bodyfat_percent/100)",
        "default_bodyfat_percent": 15
      }
    },
    "protein": {
      "base_metric": "LBM",
      "preferred_strategy": "range_by_goal_profile",
      "fallback_min_g_per_kg_tbw": 1.6,
      "high_defense_cut_trigger": {
        "goal": "cut",
        "apply_upper_range_when": [
          "energy_deficit_gte_500kcal",
          "high_frequency_training",
          "female_luteal_phase"
        ]
      }
    },
    "fat": {
      "base_metric": "TBW",
      "preferred_strategy": "range_by_goal_profile",
      "male_testosterone_floor_g_per_kg_tbw": 0.8,
      "general_floor_g_per_kg_tbw": 0.8
    },
    "carbohydrate": {
      "base_metric": "TBW",
      "preferred_strategy": "range_by_goal_profile",
      "cut_hard_floor_g_per_kg_tbw": 2.0,
      "strength_session_min_pre_training_net_carb_g": [
        15,
        30
      ],
      "intra_workout_fast_carb_g_per_hour": [
        30,
        60
      ],
      "high_volume_day_prompt": "若正式工作组超过 10 组，优先把碳水推向区间上沿。"
    },
    "training_day_carb_timing": {
      "pre": {
        "window": "-2h to -3h",
        "tbw_range_g_per_kg": [
          1.0,
          1.5
        ],
        "protein_g_per_kg_tbw": 0.3
      },
      "intra": {
        "trigger": "RPE > 9 or workout_duration_minutes > 60",
        "fast_carb_g_per_hour": [
          30,
          60
        ],
        "matrix": "glucose:fructose = 2:1"
      },
      "post": {
        "window": "+30min to +2h",
        "carb_g_per_kg_tbw": [
          1.0,
          1.2
        ],
        "protein_g_per_kg_tbw": [
          0.3,
          0.4
        ],
        "carb_to_protein_ratio": [
          3,
          1
        ]
      }
    }
  },

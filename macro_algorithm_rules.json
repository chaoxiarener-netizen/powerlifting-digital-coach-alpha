  "constraints": {
    "low_energy_availability": {
      "severity": "warning",
      "trigger": "EA below sex-specific floor",
      "user_message": "当前能量可用性可能偏低，建议优先检查总热量、训练消耗和恢复状态。"
    },
    "large_deficit": {
      "severity": "warning",
      "trigger": "daily deficit below -500 kcal or below profile lower bound",
      "user_message": "热量缺口过大时，训练质量和恢复稳定性更容易下滑。"
    },
    "low_carbohydrate": {
      "severity": "warning",
      "trigger": "training day carbohydrate below 3 g/kg TBW in strength cycle or below 2 g/kg TBW in cut cycle",
      "user_message": "碳水过低时，训练表现和神经恢复可能受影响。"
    },
    "low_protein": {
      "severity": "warning",
      "trigger": "protein below 1.6 g/kg TBW or below profile lower bound",
      "user_message": "蛋白质摄入偏低，建议优先补足基础蛋白。"
    },
    "manual_only_future_modes": {
      "peaking": {
        "status": "reserved",
        "note": "冲击/减量期策略已保留研究结论，但 V1 不自动进入模块二计算。"
      },
      "weight_cut": {
        "status": "reserved",
        "note": "赛前减重/称重期涉及高风险操作，V1 仅保留研究字段，不自动启用。"
      },
      "female_cycle": {
        "status": "reserved",
        "note": "女性周期调整仅保留说明字段，待后续有明确输入入口后再接入。"
      }
    }
  },
  "ui_notes": {
    "positioning": "本规则库用于训练营养规划与风险提示，不替代医疗诊断。",
    "user_facing_guidance": [
      "优先保证总热量、蛋白质底线和训练日前后碳水窗口。",
      "减脂期重点是守住能量可用性底线，而不是一味压低碳水。",
      "力量期更看重碳水时序与中枢恢复，不是简单全天低碳。",
      "若存在持续疲劳、明显失眠、月经紊乱或恢复异常，应考虑进一步评估。"
    ],
    "module2_mapping": {
      "goal_profiles": "映射到 state.goal",
      "day_type_multipliers": "映射到 macros.byType 的 rest/light/medium/heavy",
      "meal_distribution_templates": "映射到 mealPlans.byType",
      "training_day_carb_timing": "映射到 carbTiming",
      "constraints": "驱动 RED-S / 低碳水 / 低蛋白警告区"
    }
  },
  "citations": [
    "Relative Energy Deficiency in Sport (RED-S): Scientific, Clinical, and Practical Implications",
    "Low energy availability: history, definition and evidence of its endocrine, metabolic and physiological effects in prospective studies in females and males",
    "Is an Energy Surplus Required to Maximize Skeletal Muscle Hypertrophy Associated With Resistance Training",
    "A systematic review, meta-analysis and meta-regression of the effect of protein supplementation on resistance training-induced gains in muscle mass and strength in healthy adults",
    "How to Fuel Strength Training: Carbs, Protein & Hydration",
    "The Effect of Carbohydrate Intake on Strength and Resistance Training Performance: A Systematic Review",
    "Recommendations and Nutritional Considerations for Female Athletes: Health and Performance",
    "A Short-Term Low-Fiber Diet Reduces Body Mass in Healthy Young Men: Implications for Weight-Sensitive Sports"
  ]
}

page {
  min-height: 100vh;
  background: #0a0a0a;
  color: #e5e5e5;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 40rpx 32rpx 80rpx;
}

.panel {
  background: #141414;
  border: 1rpx solid #2a2a2a;
  border-radius: 16rpx;
  padding: 32rpx;
}

.text-dim {
  color: #888888;
}

.accent {
  color: #00ff88;
}

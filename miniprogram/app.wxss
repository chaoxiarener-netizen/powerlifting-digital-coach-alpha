/* ═══════════════════════════════════════
   力量举全景数字教练 — 小程序设计系统
   ═══════════════════════════════════════ */

/* ─── Base ─── */

page {
  min-height: 100vh;
  background: linear-gradient(180deg, #0a0a0a 0%, #0e0e0e 100%);
  color: #e5e5e5;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 24rpx 80rpx;
}

/* ─── Typography ─── */

.page-title {
  display: block;
  color: #ffffff;
  font-size: 50rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
  line-height: 1.08;
}

.page-subtitle {
  display: block;
  margin-top: 12rpx;
  color: #9a9a9a;
  font-size: 27rpx;
  line-height: 1.5;
}

.panel-title {
  display: block;
  color: #f5f5f5;
  font-size: 32rpx;
  font-weight: 700;
}

.section-title {
  display: block;
  color: #f5f5f5;
  font-size: 30rpx;
  font-weight: 800;
  margin-bottom: 4rpx;
}

.section-desc {
  display: block;
  color: #888888;
  font-size: 24rpx;
  line-height: 1.45;
  margin-bottom: 24rpx;
}

/* ─── Colors ─── */

.text-accent { color: #00ff88; }
.text-warning { color: #ffd166; }
.text-danger { color: #ff6b6b; }
.text-muted, .muted { color: #888888; }
.text-center { text-align: center; }
.text-dim { color: #888888; }

/* ─── Event type colors (shared) ─── */

.type-training { color: #00ff88; }
.type-supplement { color: #b885ea; }
.type-sleep { color: #7c5bef; }
.type-warning { color: #ffd166; }
.type-recovery { color: #6bcb9a; }
.type-wake { color: #5b8def; }

.type-bg-training { background: rgba(0, 255, 136, 0.1); border-color: rgba(0, 255, 136, 0.2); }
.type-bg-supplement { background: rgba(184, 133, 234, 0.1); border-color: rgba(184, 133, 234, 0.2); }
.type-bg-sleep { background: rgba(124, 91, 239, 0.1); border-color: rgba(124, 91, 239, 0.2); }
.type-bg-warning { background: rgba(255, 209, 102, 0.1); border-color: rgba(255, 209, 102, 0.2); }
.type-bg-recovery { background: rgba(107, 203, 154, 0.1); border-color: rgba(107, 203, 154, 0.2); }
.type-bg-wake { background: rgba(91, 141, 239, 0.1); border-color: rgba(91, 141, 239, 0.2); }

/* ─── Opacity helpers ─── */

.op-muted { opacity: 0.5; }

/* ─── Cards ─── */

.panel,
.card {
  background: #141414;
  border: 1rpx solid #262626;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.card-strong {
  background: #191919;
  border: 1rpx solid #2e2e2e;
  border-radius: 24rpx;
  padding: 36rpx;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.45);
  margin-bottom: 24rpx;
}

.card-accent {
  border-color: rgba(0, 255, 136, 0.3);
}

/* ─── Buttons ─── */

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  border-radius: 20rpx;
  padding: 0 36rpx;
  box-sizing: border-box;
  font-size: 32rpx;
  font-weight: 800;
  transition: all 0.2s ease-out;
}

.btn-primary {
  color: #061108;
  background: linear-gradient(135deg, #00ff88 0%, #00dd74 100%);
  box-shadow: 0 4rpx 28rpx rgba(0, 255, 136, 0.25);
}

.btn-primary:active {
  opacity: 0.85;
  box-shadow: 0 2rpx 12rpx rgba(0, 255, 136, 0.15);
}

.btn-secondary {
  color: #e5e5e5;
  background: #1c1c1c;
  border: 1rpx solid #333333;
}

.btn-secondary:active {
  background: #2a2a2a;
}

.btn-danger {
  color: #ffdddd;
  background: rgba(255, 68, 68, 0.1);
  border: 1rpx solid rgba(255, 68, 68, 0.3);
}

.btn-danger:active {
  background: rgba(255, 68, 68, 0.18);
}

.btn-small {
  min-height: 72rpx;
  font-size: 26rpx;
  border-radius: 16rpx;
  padding: 0 24rpx;
}

/* ─── Badge / Pill ─── */

.pill,
.badge {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
  font-size: 23rpx;
  background: rgba(0, 255, 136, 0.08);
  border: 1rpx solid rgba(0, 255, 136, 0.3);
  color: #00ff88;
  line-height: 1.4;
}

.badge-sm {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
}

/* ─── Tags ─── */

.tag {
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
  color: #00ff88;
  font-size: 21rpx;
  background: rgba(0, 255, 136, 0.08);
  border: 1rpx solid rgba(0, 255, 136, 0.2);
}

.tag-training { color: #00ff88; background: rgba(0, 255, 136, 0.08); border-color: rgba(0, 255, 136, 0.2); }
.tag-supplement { color: #b885ea; background: rgba(184, 133, 234, 0.08); border-color: rgba(184, 133, 234, 0.2); }
.tag-sleep { color: #7c5bef; background: rgba(124, 91, 239, 0.08); border-color: rgba(124, 91, 239, 0.2); }
.tag-warning { color: #ffd166; background: rgba(255, 209, 102, 0.08); border-color: rgba(255, 209, 102, 0.2); }
.tag-recovery { color: #6bcb9a; background: rgba(107, 203, 154, 0.08); border-color: rgba(107, 203, 154, 0.2); }
.tag-wake { color: #5b8def; background: rgba(91, 141, 239, 0.08); border-color: rgba(91, 141, 239, 0.2); }

/* ─── Form Fields ─── */

.field {
  margin-bottom: 24rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  color: #cfcfcf;
  font-size: 26rpx;
  font-weight: 600;
}

.input {
  width: 100%;
  min-height: 88rpx;
  border: 1rpx solid #2a2a2a;
  border-radius: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  color: #f5f5f5;
  background: #101010;
  font-size: 30rpx;
}

.picker-value {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  border: 1rpx solid #2a2a2a;
  border-radius: 16rpx;
  padding: 0 24rpx;
  color: #f5f5f5;
  background: #101010;
  font-size: 30rpx;
}

/* ─── Dividers ─── */

.divider {
  height: 1rpx;
  background: #262626;
  margin: 8rpx 0;
  border: none;
}

/* ─── Accent bar decorative ─── */

.accent-bar {
  width: 56rpx;
  height: 4rpx;
  background: #00ff88;
  border-radius: 4rpx;
  margin-bottom: 14rpx;
}

/* ─── Layout ─── */

.gap-xs { gap: 8rpx; }
.gap-sm { gap: 16rpx; }
.gap-md { gap: 24rpx; }
.gap-lg { gap: 36rpx; }

/* ─── Transitions ─── */

.smooth {
  transition: all 0.2s ease-out;
}

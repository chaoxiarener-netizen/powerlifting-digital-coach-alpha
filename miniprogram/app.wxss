page {
  min-height: 100vh;
  background: #0a0a0a;
  color: #e5e5e5;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 40rpx 32rpx 80rpx;
}

.panel {
  background: #141414;
  border: 1rpx solid #2a2a2a;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.text-dim {
  color: #888888;
}

.accent {
  color: #00ff88;
}

.page-title {
  display: block;
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  line-height: 1.08;
}

.page-subtitle {
  display: block;
  margin-top: 16rpx;
  color: #9a9a9a;
  font-size: 28rpx;
  line-height: 1.5;
}

.panel-title {
  display: block;
  margin-bottom: 18rpx;
  color: #f5f5f5;
  font-size: 32rpx;
  font-weight: 700;
}

.pill {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  border: 1rpx solid rgba(0, 255, 136, 0.35);
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
  color: #00ff88;
  font-size: 24rpx;
  background: rgba(0, 255, 136, 0.08);
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  border-radius: 16rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  font-weight: 700;
}

.btn-primary {
  color: #061108;
  background: #00ff88;
}

.btn-secondary {
  color: #e5e5e5;
  background: #1f1f1f;
  border: 1rpx solid #333333;
}

.btn-danger {
  color: #ffdddd;
  background: rgba(255, 68, 68, 0.12);
  border: 1rpx solid rgba(255, 68, 68, 0.35);
}

.field {
  margin-bottom: 24rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #cfcfcf;
  font-size: 26rpx;
}

.input {
  width: 100%;
  min-height: 84rpx;
  border: 1rpx solid #2a2a2a;
  border-radius: 14rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  color: #f5f5f5;
  background: #101010;
  font-size: 30rpx;
}

.picker-value {
  display: flex;
  align-items: center;
  min-height: 84rpx;
  border: 1rpx solid #2a2a2a;
  border-radius: 14rpx;
  padding: 0 24rpx;
  color: #f5f5f5;
  background: #101010;
  font-size: 30rpx;
}

/* ─── Utility ─── */

.smooth {
  transition: all 0.2s ease-out;
}

.gap-xs { gap: 8rpx; }
.gap-sm { gap: 16rpx; }
.gap-md { gap: 24rpx; }
.gap-lg { gap: 36rpx; }

.text-warning {
  color: #ffd166;
}

.text-danger {
  color: #ff6b6b;
}

.text-center {
  text-align: center;
}

/* ─── Button active states ─── */

.btn:active {
  opacity: 0.88;
}

.btn-primary:active {
  background: #00dd74;
}

.btn-secondary:active {
  background: #2a2a2a;
}

/* ─── Divider ─── */

.divider {
  height: 1rpx;
  background: #242424;
  margin: 8rpx 0;
  border: none;
}

/* ─── Accent bar ─── */

.accent-bar {
  width: 64rpx;
  height: 4rpx;
  background: #00ff88;
  border-radius: 4rpx;
  margin-bottom: 12rpx;
}

/* ─── Elevated panel ─── */

.panel-elevated {
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.35);
}

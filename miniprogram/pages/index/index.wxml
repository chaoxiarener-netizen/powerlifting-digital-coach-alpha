<view class="page index-page">
  <view class="hero">
    <text class="eyebrow">Alpha 小程序迁移验证版</text>
    <text class="title">力量举全景数字教练</text>
    <text class="subtitle">先验证小程序骨架，再逐步迁移总控台、单日计划和今日作战图。</text>
  </view>

  <view class="entry-list">
    <view class="entry-card" bindtap="handleEntryTap" data-mode="single_day">
      <text class="entry-title">轻量单日计划</text>
      <text class="entry-desc">快速规划今天的训练、作息和补剂。</text>
    </view>

    <view class="entry-card" bindtap="handleEntryTap" data-mode="weekly">
      <text class="entry-title">周计划模式</text>
      <text class="entry-desc">后续迁移本周训练和营养预算。</text>
    </view>

    <view class="entry-card" bindtap="handleEntryTap" data-mode="dashboard">
      <text class="entry-title">今日作战图</text>
      <text class="entry-desc">后续接入 daily_flow_engine 事件流。</text>
    </view>
  </view>
</view>

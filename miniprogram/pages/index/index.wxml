<view class="page index-page">
  <view class="hero">
    <view class="accent-bar"></view>
    <text class="hero-eyebrow">今日总控台</text>
    <text class="page-title">力量举全景数字教练</text>
    <text class="page-subtitle">Alpha 小程序迁移验证版 · 总控台、轻量单日计划和今日作战图闭环。</text>
  </view>

  <view class="action-panel">
    <text class="panel-title">现在该做什么？</text>
    <view class="now-row">
      <text class="now-time">{{nextAction.nowTime}}</text>
      <text class="now-label">{{nextAction.currentLabel}}</text>
    </view>

    <block wx:if="{{nextAction.hasData && nextAction.nextEvent}}">
      <view class="next-block">
        <text class="next-countdown">下一步 · 还有 {{nextAction.nextEvent.minutesUntil}} 分钟</text>
        <text class="next-title">{{nextAction.nextEvent.time}} {{nextAction.nextEvent.title}}</text>
        <text class="next-meta">{{nextAction.nextEvent.meta}}</text>
      </view>
      <view class="next-following" wx:if="{{nextAction.followingEvent}}">
        <text class="following-label">随后</text>
        <text class="following-text">{{nextAction.followingEvent.time}} {{nextAction.followingEvent.title}}</text>
        <text class="following-meta">{{nextAction.followingEvent.meta}}</text>
      </view>
    </block>

    <block wx:elif="{{nextAction.status === 'done_for_day'}}">
      <view class="done-badge">✓ 今日执行完成</view>
      <text class="empty-desc">{{nextAction.message}}</text>
    </block>

    <block wx:else>
      <text class="empty-title">还没有今日作战提示</text>
      <text class="empty-desc">请先创建轻量单日计划，验证 wx storage 与事件流是否跑通。</text>
    </block>
  </view>

  <view class="entry-list">
    <view class="entry-card primary" bindtap="goSingleDay">
      <view class="entry-icon accent-icon">
        <text class="icon-symbol">✦</text>
      </view>
      <view class="entry-body">
        <text class="entry-title">轻量单日计划</text>
        <text class="entry-desc">填写今天训练、作息和常用补剂，保存后生成今日作战图。</text>
      </view>
      <text class="entry-arrow">›</text>
    </view>

    <view class="entry-card" bindtap="goDashboard">
      <view class="entry-icon info-icon">
        <text class="icon-symbol">◈</text>
      </view>
      <view class="entry-body">
        <text class="entry-title">今日作战图</text>
        <text class="entry-desc">读取 singleDayPlan，展示今日摘要和时间流。</text>
      </view>
      <text class="entry-arrow">›</text>
    </view>

    <view class="entry-card danger" bindtap="clearData">
      <view class="entry-icon danger-icon">
        <text class="icon-symbol">⊗</text>
      </view>
      <view class="entry-body">
        <text class="entry-title">清空本地数据</text>
        <text class="entry-desc">仅清空 appUsageMode / singleDayPlan，用于重新验收。</text>
      </view>
    </view>
  </view>

  <text class="footer-note">本地数据 · 仅供训练规划参考</text>
</view>

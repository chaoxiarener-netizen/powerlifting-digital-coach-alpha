.index-page {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 24rpx 0 4rpx;
}

.eyebrow {
  color: #00ff88;
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

.action-panel {
  border-color: rgba(0, 255, 136, 0.42);
  box-shadow: 0 0 44rpx rgba(0, 255, 136, 0.08);
}

.now-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.now-time {
  color: #ffffff;
  font-size: 64rpx;
  font-weight: 900;
  letter-spacing: -2rpx;
}

.next-block {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 26rpx;
  border-radius: 18rpx;
  background: #101010;
  border: 1rpx solid #242424;
}

.next-title {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.28;
}

.next-meta,
.empty-desc,
.following {
  color: #a0a0a0;
  font-size: 26rpx;
  line-height: 1.5;
}

.following {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.04);
}

.empty-title {
  display: block;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
}

.empty-desc {
  display: block;
}

.entry-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.entry-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 30rpx;
  background: #141414;
  border: 1rpx solid #2a2a2a;
  border-radius: 16rpx;
}

.entry-card.primary {
  border-color: rgba(0, 255, 136, 0.38);
}

.entry-card.danger {
  border-color: rgba(255, 68, 68, 0.28);
}

.entry-card:active {
  transform: scale(0.99);
}

.entry-title {
  color: #f5f5f5;
  font-size: 32rpx;
  font-weight: 800;
}

.entry-desc {
  color: #888888;
  font-size: 26rpx;
  line-height: 1.5;
}

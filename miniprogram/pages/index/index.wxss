/* ═══════════════════════════════════════
   首页 — 今日作战总控台
   ═══════════════════════════════════════ */

.index-page {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

/* ─── Hero ─── */

.hero {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 24rpx 0 4rpx;
}

.hero-eyebrow {
  display: block;
  color: #00ff88;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  text-transform: uppercase;
}

.hero .page-title {
  font-size: 52rpx;
  line-height: 1.06;
  letter-spacing: -1.5rpx;
}

/* ─── Action panel (现在该做什么) ─── */

.action-panel {
  background: #181818;
  border-color: rgba(0, 255, 136, 0.35);
  box-shadow: 0 0 60rpx rgba(0, 255, 136, 0.06),
              0 12rpx 48rpx rgba(0, 0, 0, 0.4);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
}

.action-panel .panel-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #aaaaaa;
  margin-bottom: 20rpx;
  letter-spacing: 1rpx;
}

.now-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.now-time {
  display: block;
  color: #ffffff;
  font-size: 80rpx;
  font-weight: 900;
  letter-spacing: -4rpx;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.now-label {
  display: block;
  font-size: 24rpx;
  color: #888888;
  flex-shrink: 0;
}

/* ─── Next event card ─── */

.next-block {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 28rpx;
  border-radius: 18rpx;
  background: #111111;
  border: 1rpx solid #2a2a2a;
  border-left: 4rpx solid #00ff88;
}

.next-countdown {
  display: block;
  color: #00ff88;
  font-size: 23rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.next-title {
  display: block;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.25;
}

.next-meta {
  display: block;
  color: #a0a0a0;
  font-size: 25rpx;
  line-height: 1.5;
}

/* ─── Following event ─── */

.next-following {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-top: 16rpx;
  padding: 20rpx 24rpx 20rpx 28rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.02);
  border-left: 4rpx solid #444444;
}

.following-label {
  display: block;
  color: #666666;
  font-size: 21rpx;
  letter-spacing: 1.5rpx;
  text-transform: uppercase;
}

.following-text {
  display: block;
  color: #cccccc;
  font-size: 27rpx;
  font-weight: 700;
}

.following-meta {
  display: block;
  color: #888888;
  font-size: 23rpx;
}

/* ─── Empty states ─── */

.empty-title {
  display: block;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 800;
  margin-bottom: 10rpx;
}

.empty-desc {
  display: block;
  color: #a0a0a0;
  font-size: 25rpx;
  line-height: 1.5;
}

.done-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(0, 255, 136, 0.08);
  border: 1rpx solid rgba(0, 255, 136, 0.2);
  color: #00ff88;
  font-size: 23rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  width: fit-content;
}

/* ─── Entry cards (功能入口) ─── */

.entry-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.entry-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 26rpx 24rpx;
  background: #141414;
  border: 1rpx solid #262626;
  border-radius: 20rpx;
  transition: all 0.2s ease-out;
}

.entry-card:active {
  transform: scale(0.98);
  background: #1a1a1a;
  border-color: #3a3a3a;
}

.entry-card.primary {
  border-color: rgba(0, 255, 136, 0.25);
}

.entry-card.danger {
  border-color: rgba(255, 68, 68, 0.15);
}

/* ─── Entry body ─── */

.entry-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.entry-title {
  display: block;
  color: #f5f5f5;
  font-size: 32rpx;
  font-weight: 800;
}

.entry-desc {
  display: block;
  color: #888888;
  font-size: 24rpx;
  line-height: 1.45;
}

.entry-arrow {
  color: #444444;
  font-size: 38rpx;
  font-weight: 300;
  flex-shrink: 0;
  padding-left: 6rpx;
}

/* ─── Footer ─── */

.footer-note {
  display: block;
  text-align: center;
  color: #555555;
  font-size: 22rpx;
  line-height: 1.5;
  padding: 20rpx 0 10rpx;
}

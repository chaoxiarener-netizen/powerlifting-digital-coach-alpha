.index-page {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 28rpx 0 8rpx;
}

.eyebrow {
  color: #00ff88;
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

.title {
  color: #f5f5f5;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.15;
}

.subtitle {
  color: #9a9a9a;
  font-size: 28rpx;
  line-height: 1.6;
}

.entry-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.entry-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 32rpx;
  background: #141414;
  border: 1rpx solid #2a2a2a;
  border-radius: 16rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 255, 136, 0.06);
}

.entry-card:active {
  border-color: #00ff88;
}

.entry-title {
  color: #f5f5f5;
  font-size: 32rpx;
  font-weight: 700;
}

.entry-desc {
  color: #888888;
  font-size: 26rpx;
  line-height: 1.5;
}

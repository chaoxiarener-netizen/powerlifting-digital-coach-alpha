.index-page {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* ─── Hero ─── */

.hero {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 20rpx 0 8rpx;
}

.hero .eyebrow {
  color: #00ff88;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  font-weight: 600;
}

/* ─── Action panel ─── */

.action-panel {
  border-color: rgba(0, 255, 136, 0.42);
  box-shadow: 0 0 44rpx rgba(0, 255, 136, 0.08),
              0 8rpx 40rpx rgba(0, 0, 0, 0.3);
  background: #161616;
}

.now-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.now-time {
  color: #ffffff;
  font-size: 72rpx;
  font-weight: 900;
  letter-spacing: -3rpx;
  line-height: 1;
}

/* ─── Next event block ─── */

.next-block {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 28rpx;
  border-radius: 18rpx;
  background: #101010;
  border: 1rpx solid #2a2a2a;
}

.next-eyebrow {
  color: #00ff88;
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

.next-title {
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.28;
}

.next-meta {
  color: #a0a0a0;
  font-size: 26rpx;
  line-height: 1.5;
}

.next-following {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid #242424;
}

.following-label {
  color: #666666;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  text-transform: uppercase;
}

.following-text {
  color: #cccccc;
  font-size: 28rpx;
  font-weight: 700;
}

.following-meta {
  color: #888888;
  font-size: 24rpx;
}

/* ─── Empty states ─── */

.empty-title {
  display: block;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
}

.empty-desc {
  display: block;
  color: #a0a0a0;
  font-size: 26rpx;
  line-height: 1.5;
}

/* ─── Entry cards ─── */

.entry-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.entry-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 24rpx;
  background: #141414;
  border: 1rpx solid #2a2a2a;
  border-radius: 18rpx;
  transition: all 0.2s ease-out;
}

.entry-card:active {
  transform: scale(0.98);
  background: #1a1a1a;
  border-color: #3a3a3a;
}

.entry-card.primary {
  border-color: rgba(0, 255, 136, 0.28);
}

.entry-card.danger {
  border-color: rgba(255, 68, 68, 0.18);
}

/* ─── Entry icon ─── */

.entry-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-symbol {
  font-size: 30rpx;
}

.accent-icon {
  background: rgba(0, 255, 136, 0.1);
  border: 1rpx solid rgba(0, 255, 136, 0.2);
  color: #00ff88;
}

.info-icon {
  background: rgba(91, 141, 239, 0.1);
  border: 1rpx solid rgba(91, 141, 239, 0.2);
  color: #5b8def;
}

.danger-icon {
  background: rgba(255, 68, 68, 0.1);
  border: 1rpx solid rgba(255, 68, 68, 0.2);
  color: #ff6b6b;
}

/* ─── Entry body ─── */

.entry-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.entry-title {
  color: #f5f5f5;
  font-size: 32rpx;
  font-weight: 800;
}

.entry-desc {
  color: #888888;
  font-size: 25rpx;
  line-height: 1.45;
}

.entry-arrow {
  color: #444444;
  font-size: 40rpx;
  font-weight: 300;
  flex-shrink: 0;
  padding-left: 8rpx;
}

.single-day-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding-top: 20rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 28rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #101010;
  border: 1rpx solid #242424;
}

.switch-title {
  display: block;
  color: #f5f5f5;
  font-size: 30rpx;
  font-weight: 800;
}

.switch-desc,
.checkbox-desc {
  display: block;
  color: #888888;
  font-size: 24rpx;
  line-height: 1.5;
}

.muted {
  opacity: 0.58;
}

.checkbox-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #242424;
}

.checkbox-row:last-child {
  border-bottom: 0;
}

.checkbox-title {
  display: block;
  color: #f5f5f5;
  font-size: 28rpx;
  font-weight: 700;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-bottom: 24rpx;
}

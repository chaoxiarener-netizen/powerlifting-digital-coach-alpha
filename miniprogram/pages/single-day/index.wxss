.single-day-page {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding-top: 20rpx;
}

.hero .pill {
  margin-top: 4rpx;
}

/* ─── Panel header ─── */

.panel-head {
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #242424;
}

.panel-head .panel-title {
  margin-bottom: 0;
}

/* ─── Switch row ─── */

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 28rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #101010;
  border: 1rpx solid #2a2a2a;
}

.switch-info {
  flex: 1;
  min-width: 0;
}

.switch-title {
  display: block;
  color: #f5f5f5;
  font-size: 30rpx;
  font-weight: 800;
}

.switch-desc,
.checkbox-desc {
  display: block;
  color: #888888;
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 4rpx;
}

/* ─── Field refinements ─── */

.field {
  margin-bottom: 24rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.muted {
  opacity: 0.58;
}

/* ─── Checkbox list ─── */

.checkbox-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #242424;
}

.checkbox-row:last-child {
  border-bottom: none;
}

.checkbox-title {
  display: block;
  color: #f5f5f5;
  font-size: 28rpx;
  font-weight: 700;
}

.checkbox-desc {
  margin-top: 4rpx;
}

/* ─── Action buttons ─── */

.actions {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-bottom: 32rpx;
}

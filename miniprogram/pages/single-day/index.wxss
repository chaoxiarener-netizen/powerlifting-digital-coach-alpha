/* ═══════════════════════════════════════
   轻量单日计划
   ═══════════════════════════════════════ */

.single-day-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-top: 24rpx;
}

/* ─── Panel header ─── */

.panel-head {
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #262626;
}

.panel-head .section-title {
  margin-bottom: 0;
}

.panel-head .section-desc {
  margin-bottom: 0;
  margin-top: 4rpx;
}

/* ─── Switch row ─── */

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #111111;
  border: 1rpx solid #2a2a2a;
}

.switch-info {
  flex: 1;
  min-width: 0;
}

.switch-title {
  display: block;
  color: #f5f5f5;
  font-size: 30rpx;
  font-weight: 800;
}

.switch-desc {
  display: block;
  color: #888888;
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 4rpx;
}

/* ─── Dimmed field group (rest day) ─── */

.field-group {
  transition: opacity 0.2s ease-out;
}

.field-dimmed {
  opacity: 0.45;
}

/* ─── Checkbox list ─── */

.checkbox-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #262626;
}

.checkbox-row:last-child {
  border-bottom: none;
}

.checkbox-info {
  flex: 1;
  min-width: 0;
}

.checkbox-title {
  display: block;
  color: #f5f5f5;
  font-size: 28rpx;
  font-weight: 700;
}

.checkbox-desc {
  display: block;
  color: #888888;
  font-size: 23rpx;
  line-height: 1.5;
  margin-top: 4rpx;
}

/* ─── Action buttons ─── */

.actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-bottom: 32rpx;
  margin-top: 8rpx;
}

<view class="page dashboard-page">
  <view class="hero">
    <view class="accent-bar"></view>
    <text class="pill">训练来源：轻量单日计划</text>
    <text class="page-title">今日作战图</text>
    <text class="page-subtitle">从 singleDayPlan 生成今日摘要和关键时间流。</text>
  </view>

  <block wx:if="{{hasPlan}}">
    <!-- 今日摘要 -->
    <view class="card card-accent">
      <view class="panel-head">
        <text class="panel-title">今日摘要</text>
      </view>
      <view class="summary-grid">
        <view class="summary-item">
          <view class="summary-body">
            <text class="data-label data-label-training">TRAINING</text>
            <text class="data-value">{{summary.training}}</text>
          </view>
        </view>
        <view class="summary-item">
          <view class="summary-body">
            <text class="data-label data-label-supplement">SUPPLEMENT</text>
            <text class="data-value">{{summary.supplements}}</text>
          </view>
        </view>
        <view class="summary-item">
          <view class="summary-body">
            <text class="data-label data-label-sleep">SLEEP</text>
            <text class="data-value">{{summary.sleep}}</text>
          </view>
        </view>
        <view class="summary-item">
          <view class="summary-body">
            <text class="data-label data-label-warning">ALERT</text>
            <text class="data-value data-value-warning">{{summary.warning}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 单日时间流 -->
    <view class="card">
      <view class="panel-head">
        <text class="panel-title">单日时间流</text>
      </view>
      <view class="timeline">
        <view class="timeline-item {{item.type}}" wx:for="{{events}}" wx:key="id">
          <view class="timeline-dot"></view>
          <view class="timeline-content">
            <view class="time-row">
              <text class="time-text">{{item.displayTime}}</text>
              <view class="type-tag {{item.type}}" wx:if="{{item.type}}">
                <text>{{item.type}}</text>
              </view>
            </view>
            <text class="event-title">{{item.title}}</text>
            <text class="event-meta">{{item.meta}}</text>
            <view class="tags" wx:if="{{item.tags.length}}">
              <text class="tag tag-{{item.type}}" wx:for="{{item.tags}}" wx:key="*this">{{item}}</text>
            </view>
            <text class="event-detail">{{item.detail}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="card empty-panel text-center">
      <text class="empty-panel-title">还没有轻量单日计划</text>
      <text class="empty-desc">先创建今天的训练、作息和补剂清单，再查看今日作战图。</text>
      <view class="btn btn-primary" bindtap="goCreate">去创建</view>
    </view>
  </block>

  <view class="actions">
    <view class="btn btn-secondary" bindtap="goHome">返回总控台</view>
  </view>
</view>

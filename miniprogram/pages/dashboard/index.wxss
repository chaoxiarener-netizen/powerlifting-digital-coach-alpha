.dashboard-page {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding-top: 20rpx;
}

.summary-panel {
  border-color: rgba(0, 255, 136, 0.36);
}

.summary-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.summary-item {
  width: calc(50% - 9rpx);
  min-height: 132rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: #101010;
  border: 1rpx solid #242424;
  box-sizing: border-box;
}

.summary-label {
  display: block;
  color: #888888;
  font-size: 23rpx;
  margin-bottom: 12rpx;
}

.summary-value {
  display: block;
  color: #f5f5f5;
  font-size: 27rpx;
  line-height: 1.35;
  font-weight: 700;
}

.warning-text {
  color: #ffd166;
}

.timeline {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.timeline-item {
  display: flex;
  gap: 18rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: #101010;
  border: 1rpx solid #242424;
}

.timeline-item.warning {
  border-color: rgba(255, 209, 102, 0.45);
  background: rgba(255, 209, 102, 0.08);
}

.time-text {
  display: block;
  width: 140rpx;
  color: #00ff88;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.35;
}

.event-col {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.event-title {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
}

.event-meta,
.event-detail,
.empty-desc {
  color: #9a9a9a;
  font-size: 24rpx;
  line-height: 1.5;
}

.event-detail {
  white-space: pre-wrap;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag {
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
  color: #00ff88;
  font-size: 22rpx;
  background: rgba(0, 255, 136, 0.08);
  border: 1rpx solid rgba(0, 255, 136, 0.22);
}

.empty-panel {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.actions {
  padding-bottom: 24rpx;
}
